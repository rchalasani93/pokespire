{
  "name": "pokespire",
  "version": "1.0.0",
  "description": "A roguelike Pokémon expedition: climb the map, build a team, beat the Elite Four.",
  "scripts": {
    "dev": "wrangler dev",
    "db:migrate:local": "wrangler d1 migrations apply pokespire --local",
    "db:migrate:remote": "wrangler d1 migrations apply pokespire --remote",
    "deploy": "wrangler deploy",
    "build:data": "node scripts/build-data.mjs",
    "test": "node tests/mechanics.test.mjs"
  },
  "license": "UNLICENSED",
  "devDependencies": {
    "@pkmn/dex": "^0.10.11",
    "wrangler": "^4.153.0"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  }
}
